# Site
NEXT_PUBLIC_SITE_URL=

# Auth.js (lib/auth.ts; lands in Phase 6)
ADMIN_EMAIL=
AUTH_SECRET=
AUTH_URL=

# Resend (sign-in magic links and contact form)
RESEND_API_KEY=
RESEND_FROM=

# GitHub (CMS publish pipeline; Phase 8)
# GITHUB_TOKEN_CMS is the fine-grained PAT the CMS commit pipeline uses to
# push branches and open PRs against this repo. Scopes: contents and
# pull-requests, write, on this repo only. See `lib/github.ts` for the
# lazy read pattern that keeps CI builds green when the token is absent.
GITHUB_TOKEN_CMS=
GITHUB_REPO=
GITHUB_BRANCH_BASE=

# Database (Neon Postgres; sessions and rate-limit only)
DATABASE_URL=

# Vercel KV / Upstash Redis (sign-in rate limit; Phase 6).
# The Vercel KV integration injects these names automatically; keep them
# stable so `lib/auth/rate-limit.ts` (slice #38) reads from one source.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Vercel Blob (image uploads; Phase 7)
BLOB_READ_WRITE_TOKEN=

# Sentry (error monitoring; Phase 10)
SENTRY_DSN=

# Cloudflare Turnstile (contact form spam protection; Phase 10)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
