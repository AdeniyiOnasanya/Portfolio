name: Lighthouse CI

# Phase 11 slices #63, #64, #66.
#
# Disabled by file extension (.yml.disabled) while the repo's GitHub
# Actions billing is paused. Rename back to .yml once billing clears
# to activate the gate. See USER_TODO.md "Re-enable GitHub Actions".
#
# Triggers:
#   - deployment_status: success runs the audit against the Vercel
#     preview origin as soon as the preview is live (slice #63).
#   - pull_request to develop, staging, main re-runs against the same
#     preview origin so the check appears on every PR (slice #66).
#     Note: making this a *required* check needs server-side branch
#     protection (GitHub Pro). The slice still ships the check
#     appearance; required-check enforcement stays manual per
#     CLAUDE.md "rule lives in the developer's hand".

on:
  deployment_status:
  pull_request:
    branches: [develop, staging, main]

permissions:
  contents: read
  pull-requests: write
  statuses: write
  deployments: read

concurrency:
  group: lighthouse-${{ github.ref }}
  cancel-in-progress: true

jobs:
  lhci:
    if: github.event.deployment_status.state == 'success' || github.event_name == 'pull_request'
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - name: Resolve preview origin
        id: origin
        run: |
          if [ "${{ github.event_name }}" = "deployment_status" ]; then
            echo "url=${{ github.event.deployment_status.target_url }}" >> "$GITHUB_OUTPUT"
          else
            # On a pull_request event there is no deployment URL yet;
            # the LHCI job exits early until the deployment_status
            # event fires for the same SHA.
            echo "url=" >> "$GITHUB_OUTPUT"
          fi

      - name: Skip when no preview URL available
        if: steps.origin.outputs.url == ''
        run: |
          echo "No preview URL available on this event; LHCI will run on the matching deployment_status:success event instead."
          exit 0

      - name: Audit / + project + project-with-deep-dive (slice #64)
        if: steps.origin.outputs.url != ''
        uses: treosh/lighthouse-ci-action@v12
        with:
          urls: |
            ${{ steps.origin.outputs.url }}/
            ${{ steps.origin.outputs.url }}/projects/foster-care-platform
            ${{ steps.origin.outputs.url }}/projects/multi-cloud-platform
          configPath: ./.lighthouserc.json
          uploadArtifacts: true
          temporaryPublicStorage: true
